{
  "name": "dsh-mobile",
  "version": "0.2.0",
  "description": "DshAPP mobile access for DeepSeek Harness: CF Worker gateway (pairing + WebRTC signaling only) + P2P DataChannel direct link, no traffic relay, one plugin.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "node-datachannel": "^0.26.0"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-sidebar"],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "mobile", "pairing", "p2p", "webrtc"],
  "files": ["lib", "cordis.patch.yml", "README.md", "PROTOCOL.md"]
}
