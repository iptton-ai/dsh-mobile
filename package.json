{
  "name": "dsh-mobile",
  "version": "0.2.0",
  "description": "DshAPP mobile access for DeepSeek Harness: CF Worker gateway (pairing + WS relay data plane, E2E-encrypted), relay is the only data link.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-sidebar"],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "mobile", "pairing", "relay"],
  "files": ["lib", "cordis.patch.yml", "README.md", "PROTOCOL.md"]
}
